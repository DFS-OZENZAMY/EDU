generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model School {
  id              Int              @id @default(autoincrement())
  name            String
  domain          String?          @unique
  address         String?
  city            String?
  logo            String?
  plan            SubscriptionTier @default(FREE)
  ownerName       String?
  ownerEmail      String?
  ownerPhone      String?
  enabledModules  Json?            @default("{}")
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions Json?            @default("{}")
  canteenMenus    CanteenMenu[]
  busRoutes       BusRoute[]
  classes         Class[]
  students        Student[]
  subscriptions   Subscription[]
  users           User[]
}

model Subscription {
  id        Int              @id @default(autoincrement())
  schoolId  Int
  stripeId  String?          @unique
  status    String
  tier      SubscriptionTier
  amount    Float?
  startDate DateTime         @default(now())
  endDate   DateTime?
  school    School           @relation(fields: [schoolId], references: [id])
}

model User {
  id               Int              @id @default(autoincrement())
  email            String           @unique
  password         String
  name             String
  role             Role             @default(STUDENT)
  phone            String?
  cin              String?
  isActive         Boolean          @default(true)
  schoolId         Int?
  createdAt        DateTime         @default(now())
  teacherClasses   Class[]          @relation("TeacherToClass")
  clockIns         ClockIn[]
  employeeProfile  EmployeeProfile?
  fees             Fee[]
  lessonLogs       LessonLog[]
  messagesReceived Message[]        @relation("ReceivedMessages")
  messagesSent     Message[]        @relation("SentMessages")
  notifications    Notification[]
  salaryPayments   SalaryPayment[]
  parentStudents   Student[]        @relation("ParentToStudent")
  school           School?          @relation(fields: [schoolId], references: [id])
}

model EmployeeProfile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  baseSalary   Float    @default(0)
  contractType String   @default("CDI")
  rib          String?
  cnssNumber   String?
  hiringDate   DateTime @default(now())
  position     String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SalaryPayment {
  id     Int      @id @default(autoincrement())
  userId Int
  amount Float
  bonus  Float    @default(0)
  month  String
  status String   @default("PAID")
  paidAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id])
}

model ClockIn {
  id     Int      @id @default(autoincrement())
  userId Int
  time   DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id])
}

model Fee {
  id          Int       @id @default(autoincrement())
  parentId    Int
  month       String
  amount      Float
  status      String    @default("PENDING")
  paidAt      DateTime?
  invoiceUrl  String?
  createdAt   DateTime  @default(now())
  paymentMode String?
  studentId   Int?
  parent      User      @relation(fields: [parentId], references: [id])
  student     Student?  @relation(fields: [studentId], references: [id])
}

model Student {
  id             Int          @id @default(autoincrement())
  name           String
  birthday       DateTime?
  gender         String?      @default("M")
  nationalId     String?      @unique
  medicalInfo    String?
  bloodType      String?
  emergencyPhone String?
  schoolId       Int
  classId        Int?
  parentId       Int?
  attendance     Attendance[]
  fees           Fee[]
  grades         Grade[]
  class          Class?       @relation(fields: [classId], references: [id])
  parent         User?        @relation("ParentToStudent", fields: [parentId], references: [id])
  school         School       @relation(fields: [schoolId], references: [id])
  guardians      Guardian[]
  busRouteId     Int?
  busRoute       BusRoute?    @relation(fields: [busRouteId], references: [id])
  achievements   Achievement[]
}

model Achievement {
  id          Int      @id @default(autoincrement())
  studentId   Int
  title       String
  icon        String?
  points      Int      @default(0)
  date        DateTime @default(now())
  description String?
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model BusRoute {
  id          Int       @id @default(autoincrement())
  schoolId    Int
  name        String
  driverName  String?
  driverPhone String?
  busNumber   String?
  capacity    Int       @default(30)
  school      School    @relation(fields: [schoolId], references: [id])
  students    Student[]
  stops       BusStop[]
}

model BusStop {
  id       Int      @id @default(autoincrement())
  routeId  Int
  name     String
  time     String?
  order    Int      @default(0)
  route    BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
}

model Guardian {
  id           Int      @id @default(autoincrement())
  name         String
  relationship String
  phone        String
  email        String?
  isPrimary    Boolean  @default(false)
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Class {
  id         Int         @id @default(autoincrement())
  name       String
  level      String
  room       String?
  schoolId   Int
  teacherId  Int?
  school     School      @relation(fields: [schoolId], references: [id])
  teacher    User?       @relation("TeacherToClass", fields: [teacherId], references: [id])
  lessonLogs LessonLog[]
  students   Student[]
}

model Grade {
  id          Int      @id @default(autoincrement())
  studentId   Int
  subject     String
  value       Float
  observation String?
  date        DateTime @default(now())
  student     Student  @relation(fields: [studentId], references: [id])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  status    String
  date      DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])
}

model LessonLog {
  id        Int      @id @default(autoincrement())
  classId   Int
  teacherId Int
  subject   String
  content   String
  homework  String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])
  teacher   User     @relation(fields: [teacherId], references: [id])
}

model CanteenMenu {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  date      DateTime
  dish      String
  dessert   String?
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, date])
}

model Message {
  id         Int      @id @default(autoincrement())
  content    String
  senderId   Int
  receiverId Int
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
  STAFF
  ACCOUNTANT
}

enum SubscriptionTier {
  FREE
  STANDARD
  PREMIUM
  ENTERPRISE
}
